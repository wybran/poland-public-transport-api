{
	"$schema": "node_modules/wrangler/config-schema.json",
	"compatibility_date": "2025-06-04",
	"main": "src/index.ts",
	"name": "poland-public-transport",
	"workers_dev": false,
	// GTFS timetable JSON generated by `pnpm gtfs` (scripts/gtfs/build.ts).
	// Not served publicly — the Worker reads it through the ASSETS binding.
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}
