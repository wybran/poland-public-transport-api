{
  // Worker code. Node scripts have their own config in scripts/tsconfig.json.
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "lib": ["ESNext"],
    // Don't pull @types/node into Worker code
    "types": []
  },
  "include": ["src", "worker-configuration.d.ts"]
}
